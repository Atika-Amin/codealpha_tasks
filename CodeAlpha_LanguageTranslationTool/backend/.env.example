# Copy this file to .env and fill in the provider you're using.
# Never commit the real .env file — it holds live API keys.

# Which provider the backend uses:
#   google_free    (default) — free, unofficial, no key/card/install needed.
#                    Nothing to configure below for this one. See app.py's
#                    top comment for the caveats (it's not an official API).
#   libretranslate — self-hosted via Docker, free forever, no key needed.
#   google         — official Google Cloud Translate (paid tier, card needed)
#   azure          — Microsoft Translator (paid tier, card needed)
TRANSLATE_PROVIDER=google_free

# --- LibreTranslate (self-hosted) ---
# Only used if TRANSLATE_PROVIDER=libretranslate. Change only if you run
# the Docker container on a different host/port than the README's example
# (which maps it to localhost:5001).
LIBRETRANSLATE_URL=http://localhost:5001

# --- Google Cloud Translate (optional, paid tier / card required) ---
# 1. Create/select a project at https://console.cloud.google.com
# 2. Enable the "Cloud Translation API" on that project
# 3. Create an API key under APIs & Services > Credentials
GOOGLE_TRANSLATE_API_KEY=

# --- Microsoft (Azure) Translator (optional, paid tier / card required) ---
# 1. Create a "Translator" resource at https://portal.azure.com
# 2. Copy its key and region from the resource's "Keys and Endpoint" page
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
